{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "Quiz",
    "description": "Language learning quiz"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "targetLanguage": {
      "type": "enumeration",
      "enum": ["pt", "en", "fr"],
      "required": true
    },
    "level": {
      "type": "enumeration",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2"],
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["multiple-choice", "fill-gap", "flashcard"],
      "required": true
    },
    "questions": {
      "type": "json",
      "required": true
    },
    "estimatedMinutes": {
      "type": "integer",
      "min": 1
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "isPublic": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "private": true
    }
  }
}
